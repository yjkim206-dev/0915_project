# Vercel CLI
VERCEL_ACCESS_TOKEN=
VERCEL_TOKEN=

# Supabase project and Edge Function
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PROJECT_REF=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase CLI personal access token
SUPABASE_ACCESS_TOKEN=

# Administrator account provisioned into Supabase Auth and public.admins on login.
# Set these only in your local .env or hosting secrets; never commit the real values.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Vercel frontend runtime variable
VITE_API_URL=https://your-project-ref.supabase.co/functions/v1/api
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
