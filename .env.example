# Toss Payments test keys. The client key is public; the secret key is server-only.
# Use a matching test_ck_* / test_sk_* pair from the Toss Payments developer center.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# Private auto-renewal scheduler secret, provisioned by configure-subscriptions.mjs.
SUBSCRIPTION_CRON_SECRET=
# Vercel frontend build variable: copy the same public value from TOSS_CLIENT_KEY.
VITE_TOSS_CLIENT_KEY=

# Supabase CLI personal access token
SUPABASE_ACCESS_TOKEN=

# Administrator account provisioned into Supabase Auth and public.admins on login.
# Set these only in your local .env or hosting secrets; never commit the real values.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Vercel frontend runtime variable
VITE_SITE_URL=https://onboardproject.shop
